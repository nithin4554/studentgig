# StudentGig Backend Environment Variables
# Copy this file to .env and fill in the values

# Groq AI API Key (Get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (Defaults for local XAMPP)
# DB_USER=root
# DB_PASS=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=studentgig_db

# JWT Security
# SECRET_KEY=your_internal_secret_key_here
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=43200
