<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for StudentGig.
    Default: HTTPS only (blocks cleartext).
    Exception: localhost/emulator IPs for local development.
-->
<network-security-config>
    <!-- Debug: trust user-installed certs (e.g. Charles proxy) -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Default: HTTPS only for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Exception: allow cleartext ONLY for local dev IPs -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.76.125.154</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
