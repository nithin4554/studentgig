# StudentGig Professional .gitignore

# --- IDEs & OS ---
.idea/
.gradle/
.kotlin/
*.iml
*.iws
*.ipr
.DS_Store
Thumbs.db
desktop.ini

# --- Mobile (Android) ---
mobile/build/
mobile/.cxx/
mobile/.externalNativeBuild/
mobile/captures/
mobile/google-services.json
mobile/local.properties

# --- Backend (Python) ---
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/.env
backend/venv/
backend/env/
backend/.venv/
backend/.pytest_cache/
backend/server_*.log
backend/backend_err.txt
backend/backend_error*.txt

# --- Web (Node.js/Vite) ---
web/node_modules/
web/dist/
web/dist-ssr/
web/*.local
web/.env
web/.env.*
!web/.env.example

# --- General Logs & Temporary Files ---
*.log
scripts/dev_utils/*.log
ip.txt
out.txt
crash*.txt

# --- Binaries & Sensitive Data ---
*.apk
*.aar
*.jks
*.keystore
local.properties
serviceAccountKey.json
